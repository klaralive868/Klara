# Canonical app origin — every auth email link (invite, confirm, password
# reset) is built from this, never from the triggering request's own origin.
# Set to the real production domain in every deployed environment (including
# Vercel preview builds) so a link generated from a preview deploy still
# points somewhere that will exist when the recipient clicks it.
PUBLIC_SITE_URL=http://127.0.0.1:5183

# Supabase — local dev values come from `npx supabase start` output.
# PUBLIC_* vars are exposed to the browser; never put the service-role key there.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never log, never commit, never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
